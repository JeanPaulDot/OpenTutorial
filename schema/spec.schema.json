{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@opentutorial/core/dist/spec.schema.json",
  "title": "TutorialSpec",
  "description": "An OpenTutorial tour definition. Add \"$schema\" to a spec file for editor autocomplete.",
  "type": "object",
  "required": ["specVersion", "id", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "specVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case, unique across your tours."
    },
    "title": { "$ref": "#/definitions/i18nContent" },
    "description": { "$ref": "#/definitions/i18nContent" },
    "version": {
      "type": "string",
      "description": "Bump to re-show a tour users have already completed."
    },
    "priority": {
      "type": "number",
      "description": "Higher wins when several tours are eligible at once."
    },
    "trigger": { "$ref": "#/definitions/trigger" },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showIf": { "type": "string", "maxLength": 500 }
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": { "type": "number", "minimum": 0 },
        "cooldown": { "type": "number", "minimum": 0 },
        "perSession": { "type": "number", "minimum": 0 }
      }
    },
    "onComplete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startTour": { "type": "string" },
        "emit": { "type": "string" },
        "navigate": { "type": "string", "pattern": "^/" }
      }
    },
    "interaction": { "$ref": "#/definitions/interaction" },
    "theme": { "$ref": "#/definitions/theme" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "i18nContent": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string" },
            "fallback": { "type": "string" }
          }
        }
      ]
    },
    "interaction": {
      "enum": ["free", "target-only", "blocked"],
      "description": "free = page stays usable; target-only = only the highlight is clickable; blocked = popover only."
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": { "type": "string" },
        "bg": { "type": "string" },
        "fg": { "type": "string" },
        "muted": { "type": "string" },
        "border": { "type": "string" },
        "success": { "type": "string" },
        "danger": { "type": "string" },
        "backdrop": { "type": "string" },
        "radius": { "type": "number" },
        "shadow": { "type": "string" },
        "font": { "type": "string" },
        "fontSize": { "type": "number" },
        "spacing": { "type": "number" },
        "arrowSize": { "type": "number" },
        "overlayBlur": { "type": "number" },
        "animationMs": { "type": "number" },
        "z": { "type": "number" },
        "spotlightRing": { "type": "string" },
        "popoverWidth": { "type": "number" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["manual", "auto", "event", "route", "element", "idle", "scroll"] },
        "once": { "type": "boolean" },
        "delay": { "type": "number", "minimum": 0 },
        "event": { "type": "string" },
        "path": { "type": "string" },
        "exact": { "type": "boolean" },
        "selector": { "type": "string" },
        "timeout": { "type": "number", "minimum": 0 },
        "ms": { "type": "number", "exclusiveMinimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "event" } }, "required": ["type"] },
          "then": { "required": ["event"] }
        },
        {
          "if": { "properties": { "type": { "const": "route" } }, "required": ["type"] },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "type": { "const": "element" } }, "required": ["type"] },
          "then": { "required": ["selector"] }
        },
        {
          "if": { "properties": { "type": { "const": "idle" } }, "required": ["type"] },
          "then": { "required": ["ms"] }
        },
        {
          "if": { "properties": { "type": { "const": "scroll" } }, "required": ["type"] },
          "then": { "required": ["percent"] }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["selector"] }, { "required": ["text"] }],
      "properties": {
        "selector": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          ],
          "description": "A CSS selector, or an ordered fallback list — the first match wins."
        },
        "text": { "type": "string", "description": "Match by visible text content." },
        "index": { "type": "integer", "minimum": 0 },
        "shadow": { "type": "boolean", "description": "Search open shadow roots too." },
        "iframe": { "type": "string", "description": "Selector of a same-origin iframe to search inside." },
        "waitFor": { "type": "boolean" },
        "timeout": { "type": "number", "minimum": 0 },
        "visible": { "type": "boolean" },
        "scrollIntoView": { "type": "boolean" },
        "scrollBehavior": { "enum": ["auto", "smooth"] },
        "padding": { "type": "number", "minimum": 0 }
      }
    },
    "contentBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "image", "video", "list", "code", "divider", "html"] },
        "value": {},
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "poster": { "type": "string" },
        "autoplay": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "controls": { "type": "boolean" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/i18nContent" } },
        "ordered": { "type": "boolean" },
        "lang": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
          "then": { "required": ["src", "alt"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["src"] }
        },
        {
          "if": { "properties": { "type": { "const": "list" } }, "required": ["type"] },
          "then": { "required": ["items"] }
        }
      ]
    },
    "stepContent": {
      "oneOf": [
        { "$ref": "#/definitions/i18nContent" },
        {
          "type": "object",
          "required": ["blocks"],
          "additionalProperties": false,
          "properties": {
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/contentBlock" }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "title", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/definitions/target" },
        "placement": {
          "enum": [
            "auto", "center",
            "top", "top-start", "top-end",
            "bottom", "bottom-start", "bottom-end",
            "left", "left-start", "left-end",
            "right", "right-start", "right-end"
          ]
        },
        "display": { "enum": ["spotlight", "hotspot", "beacon", "modal", "banner"] },
        "title": { "$ref": "#/definitions/i18nContent" },
        "content": { "$ref": "#/definitions/stepContent" },
        "buttons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "next": { "oneOf": [{ "$ref": "#/definitions/i18nContent" }, { "const": false }] },
            "back": { "oneOf": [{ "$ref": "#/definitions/i18nContent" }, { "const": false }] },
            "skip": { "oneOf": [{ "$ref": "#/definitions/i18nContent" }, { "const": false }] },
            "done": { "$ref": "#/definitions/i18nContent" }
          }
        },
        "advanceOn": {
          "enum": [
            "button", "target-click", "event", "auto",
            "input-match", "form-submit", "element-appears", "element-disappears", "url-match"
          ]
        },
        "event": { "type": "string" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "match": { "type": "string" },
        "watch": { "type": "string" },
        "urlPattern": { "type": "string" },
        "interaction": { "$ref": "#/definitions/interaction" },
        "skippable": { "type": "boolean" },
        "canGoBack": { "type": "boolean" },
        "next": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["if", "to"],
                "additionalProperties": false,
                "properties": {
                  "if": { "type": "string", "maxLength": 500 },
                  "to": { "type": "string" }
                }
              }
            }
          ]
        },
        "showIf": { "type": "string", "maxLength": 500 },
        "theme": { "$ref": "#/definitions/theme" },
        "onEnter": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "onExit": { "type": "array", "items": { "$ref": "#/definitions/action" } }
      },
      "allOf": [
        {
          "if": { "properties": { "advanceOn": { "const": "event" } }, "required": ["advanceOn"] },
          "then": { "required": ["event"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "auto" } }, "required": ["advanceOn"] },
          "then": { "required": ["duration"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "target-click" } }, "required": ["advanceOn"] },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "input-match" } }, "required": ["advanceOn"] },
          "then": { "required": ["target", "match"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "form-submit" } }, "required": ["advanceOn"] },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "element-appears" } }, "required": ["advanceOn"] },
          "then": { "required": ["watch"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "element-disappears" } }, "required": ["advanceOn"] },
          "then": { "required": ["watch"] }
        },
        {
          "if": { "properties": { "advanceOn": { "const": "url-match" } }, "required": ["advanceOn"] },
          "then": { "required": ["urlPattern"] }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["emit", "click", "focus", "navigate", "setContext", "scrollTo", "wait"] },
        "name": { "type": "string" },
        "detail": {},
        "path": { "type": "string", "pattern": "^/" },
        "key": { "type": "string" },
        "value": {},
        "selector": { "type": "string" },
        "ms": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "emit" } }, "required": ["type"] },
          "then": { "required": ["name"] }
        },
        {
          "if": { "properties": { "type": { "const": "navigate" } }, "required": ["type"] },
          "then": { "required": ["path"] }
        },
        {
          "if": { "properties": { "type": { "const": "setContext" } }, "required": ["type"] },
          "then": { "required": ["key"] }
        },
        {
          "if": { "properties": { "type": { "const": "scrollTo" } }, "required": ["type"] },
          "then": { "required": ["selector"] }
        }
      ]
    }
  }
}
